---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Aequitas Partners | Institutional Asset Management">
  <!-- Navigation Header -->
  <header class="border-b border-slate-800 bg-[#0b0f19]/80 backdrop-blur sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
      <span class="text-white font-semibold tracking-wider uppercase text-sm">
        AEQUITAS <span class="text-slate-500 font-normal">CAPITAL</span>
      </span>
      <nav class="hidden md:flex space-x-8 text-sm">
        <a href="#services" class="hover:text-white transition">Capabilities</a>
        <a href="#about" class="hover:text-white transition">Mandate</a>
        <a href="#contact" class="hover:text-white transition">Institutional Access</a>
      </nav>
    </div>
  </header>

  <!-- Hero Section -->
  <main class="max-w-6xl mx-auto px-6 py-24 sm:py-32">
    <div class="max-w-2xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 text-xs border border-slate-700 rounded-full text-slate-300 mb-6 bg-slate-900/50">
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        Managing $1.4B in corporate liquidity
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold text-white tracking-tight leading-tight">
        Disciplined capital preservation for modern enterprises.
      </h1>
      <p class="mt-6 text-lg text-slate-400 leading-relaxed">
        We structure, protect, and optimize balance sheet assets through low-volatility fixed income, algorithmic treasury execution, and risk hedging.
      </p>
      <div class="mt-8 flex gap-4">
        <button id="cta-btn" class="bg-white text-slate-950 font-medium px-5 py-3 rounded text-sm hover:bg-slate-200 transition">
          Schedule Briefing
        </button>
      </div>
    </div>

    <!-- Services Grid -->
    <section id="services" class="mt-28 grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="card-border bg-[#111625] p-8 rounded-lg">
        <h3 class="text-white font-medium text-lg">Treasury Management</h3>
        <p class="mt-3 text-sm text-slate-400 leading-relaxed">
          Optimizing corporate cash reserves across high-yield sovereign notes and institutional money markets.
        </p>
      </div>

      <div class="card-border bg-[#111625] p-8 rounded-lg">
        <h3 class="text-white font-medium text-lg">Risk & Hedging</h3>
        <p class="mt-3 text-sm text-slate-400 leading-relaxed">
          Mitigating FX fluctuations and interest rate volatility through conservative derivative structures.
        </p>
      </div>

      <div class="card-border bg-[#111625] p-8 rounded-lg">
        <h3 class="text-white font-medium text-lg">Fiduciary Audit</h3>
        <p class="mt-3 text-sm text-slate-400 leading-relaxed">
          Independent balance sheet governance and compliance reviews aligned with global statutory standards.
        </p>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="border-t border-slate-900 py-10 text-xs text-slate-600">
    <div class="max-w-6xl mx-auto px-6 flex justify-between">
      <span>© 2026 Aequitas Partners. All rights reserved.</span>
      <span>Institutional Services Only</span>
    </div>
  </footer>
</Layout>
