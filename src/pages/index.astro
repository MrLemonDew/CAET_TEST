---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
import "98.css"; // Import 98.css for the retro UI
---

<Layout title="EUR/USD Trader - Windows XP Edition">
  <style>
    /* Basic reset and background for retro look */
    body {
      background-color: #008080; /* Windows 95/98 Classic Teal Background */
      margin: 0;
      padding: 0;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      overflow: hidden;
      font-family: Tahoma, 'Segoe UI', Geneva, Verdana, sans-serif;
    }

    /* Mobile container */
    #mobile-container {
      width: 100%;
      max-width: 480px;
      height: 100vh;
      max-height: 850px;
      display: flex;
      flex-direction: column;
      position: relative;
    }

    @media (min-width: 481px) {
      #mobile-container {
        height: 90vh;
        border: 2px solid #000;
        box-shadow: inset 1px 1px #fff, inset -1px -1px #848584;
      }
    }

    /* Override 98.css window styles to fit our layout */
    .window {
      display: flex;
      flex-direction: column;
      height: 100%;
      margin: 0;
    }

    .window-body {
      flex: 1;
      display: flex;
      flex-direction: column;
      margin: 0;
      padding: 8px;
      gap: 8px;
      overflow-y: auto;
    }

    #chart-container {
      flex: 1;
      min-height: 300px;
      background: white;
      border: inset 2px #fff; /* 98 style border */
      box-shadow: inset -1px -1px #fff, inset 1px 1px #848584, inset -2px -2px #dfdfdf, inset 2px 2px #0a0a0a;
    }

    .status-panel, .controls-panel {
      padding: 8px;
    }

    .controls-panel {
      display: flex;
      gap: 10px;
      justify-content: center;
    }

    .trade-btn {
      flex: 1;
      padding: 10px;
      font-weight: bold;
      font-size: 16px;
    }

    .trade-btn.buy {
      color: #008000;
    }

    .trade-btn.sell {
      color: #800000;
    }

    .player-stats {
      font-size: 12px;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .player-stats .stat-row {
      display: flex;
      justify-content: space-between;
    }

    #fullscreen-btn {
      position: absolute;
      top: 2px;
      right: 2px;
      z-index: 100;
      /* Style to look like a small window button if outside the window,
         but here we'll place it in the title bar */
    }

  </style>

  <div id="mobile-container">
    <div class="window">
      <div class="title-bar">
        <div class="title-bar-text">EUR/USD Trader</div>
        <div class="title-bar-controls">
          <button aria-label="Minimize"></button>
          <button aria-label="Maximize" id="fullscreen-toggle"></button>
          <button aria-label="Close"></button>
        </div>
      </div>
      <div class="window-body">

        <!-- Human Player Status -->
        <fieldset class="status-panel">
          <legend>My Account</legend>
          <div class="player-stats">
            <div class="stat-row">
              <span>Balance (USD):</span>
              <span id="human-usd">$100,000,000.00</span>
            </div>
            <div class="stat-row">
              <span>Position (EUR):</span>
              <span id="human-eur">€0.00</span>
            </div>
          </div>
        </fieldset>

        <!-- Chart Container -->
        <div id="chart-container"></div>

        <!-- Controls -->
        <fieldset class="controls-panel">
          <legend>Execute Trade (1M EUR)</legend>
          <button class="trade-btn buy" id="btn-buy">BUY</button>
          <button class="trade-btn sell" id="btn-sell">SELL</button>
        </fieldset>

        <!-- AI Players Status -->
        <fieldset class="status-panel">
          <legend>Market Participants (AI)</legend>
          <div class="player-stats" id="ai-stats-container">
            <!-- AI stats injected via JS -->
          </div>
        </fieldset>

      </div>
    </div>
  </div>

  <script>
    // Fullscreen logic
    const fullscreenToggle = document.getElementById('fullscreen-toggle');
    if (fullscreenToggle) {
      fullscreenToggle.addEventListener('click', () => {
        if (!document.fullscreenElement) {
          document.documentElement.requestFullscreen().catch((err) => {
            console.error(`Error attempting to enable fullscreen: ${err.message}`);
          });
        } else {
          document.exitFullscreen();
        }
      });
    }
  </script>

  <!-- Mount the Game Logic -->
  <script>
    import "../scripts/game.js";
  </script>

</Layout>
